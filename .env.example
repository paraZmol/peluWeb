APP_NAME=peluWeb
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_PE

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=peluweb
DB_USERNAME=peluweb
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Login con Google (opcional): https://console.cloud.google.com/apis/credentials
# Notificaciones push. Genera el par con: php artisan webpush:keys
# Vacío = no se envían notificaciones (el correo sigue saliendo).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Subscriptions (config/billing.php): founder offer limits and where salons pay
BILLING_FOUNDER_SLOTS=5
BILLING_FOUNDER_ENDS_ON=
BILLING_YAPE_NUMBER=
BILLING_PAYEE_NAME=

# Legal pages and Libro de Reclamaciones (config/legal.php): who provides the service
LEGAL_PROVIDER_NAME=
LEGAL_PROVIDER_RUC=
LEGAL_PROVIDER_ADDRESS=
LEGAL_CONTACT_EMAIL=
LEGAL_PRIVACY_EMAIL=
LEGAL_SUPPORT_HOURS=
LEGAL_JURISDICTION_CITY=
LEGAL_HOSTING_PROVIDER=
LEGAL_MAIL_PROVIDER=
LEGAL_PAYMENT_REGISTRATION_TERM=
